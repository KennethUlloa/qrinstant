---
import Footer from "../components/Footer.astro";
import Header from "../components/Header.astro";
import SEO from "../components/SEO.astro";
import siteInfo from "../../metadata";
import "../styles/global.css";
---

<!doctype html>
<html lang="es">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width" />
    <link rel="icon" type="image/png" href={siteInfo.image} />
    <meta name="generator" content={Astro.generator} />
    <SEO />
  </head>
  <body
    class="bg-linear-to-br from-slate-900 to-slate-800 text-white min-h-screen flex flex-col"
  >
    <Header />
    <slot />
    <Footer />
  </body>
</html>
